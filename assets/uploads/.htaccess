# Hardening: Block PHP/script execution in uploads folder
# Prevent uploaded files from being executed as scripts

Options -Indexes -ExecCGI

# Deny all PHP/script files
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|phar|sh|pl|py|cgi|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>

# Only allow safe file types
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|pdf|mp4|mp3|css|js|woff|woff2|ttf|eot)$">
    Require all granted
</FilesMatch>

# Disable PHP engine entirely in this directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
